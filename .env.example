# Copy to .env for local (non-Docker) runs. Docker Compose sets these itself.
# Defaults assume the infra from ../infra-containers is up (./start-containers.sh).
# All variables are prefixed OVC_.

OVC_ENV=dev
OVC_LOG_LEVEL=INFO
OVC_LOG_JSON=false

# HTTP
OVC_API_PREFIX=/api
OVC_CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL (async DSN) - infra-containers: ovc / ovc123 / db ovc
OVC_DATABASE_URL=postgresql+asyncpg://ovc:ovc123@localhost:5432/ovc
OVC_DB_ECHO=false

# Valkey / Redis
OVC_VALKEY_URL=redis://localhost:6379/0

# RabbitMQ - infra-containers: ovc / ovc123
OVC_RABBITMQ_URL=amqp://ovc:ovc123@localhost:5672/
# HTTP management API (rabbitmq:*-management) - used by the startup preflight
OVC_RABBITMQ_MGMT_URL=http://localhost:15672
# AMQP URL agents on Hyper-V hosts use to reach the broker, WITHOUT credentials
# (e.g. amqp://rabbit.corp.local:5672/). Shown in the host "Setup Agent" tab's
# config.ini. Empty ⇒ reuse OVC_RABBITMQ_URL's host/port/vhost.
# OVC_AGENT_RABBITMQ_URL=
OVC_AGENT_OFFLINE_AFTER_SECONDS=120
# quick host/VM metrics: how long a sample is kept before the worker prunes it
OVC_METRICS_RETENTION_SECONDS=3600

# Startup preflight: verify + repair Valkey / Postgres / RabbitMQ, then exit on failure
OVC_PREFLIGHT=true
OVC_PREFLIGHT_RUN_MIGRATIONS=true
OVC_PREFLIGHT_MANAGE_RABBITMQ_USERS=true

# Auth: "stub" trusts every request as OVC_STUB_USER_EMAIL; "oidc" verifies JWTs
# from any OpenID Connect provider (Keycloak, Auth0, Okta, Entra ID, …).
OVC_AUTH_MODE=stub
OVC_STUB_USER_EMAIL=operator@ovc.local
# infra-containers ships a Keycloak realm at http://localhost:8080 (admin / admin)
# OVC_OIDC_ISSUER=http://localhost:8080/realms/ovc
# OVC_OIDC_AUDIENCE=ovc-frontend
# OVC_OIDC_JWKS_URL=http://localhost:8080/realms/ovc/protocol/openid-connect/certs
# OVC_OIDC_CLIENT_ID=ovc-frontend
# Dot-path to the roles array in the token ("${client_id}" is substituted).
#   Keycloak client roles (default): resource_access.${client_id}.roles
#   Keycloak realm roles           : realm_access.roles
#   Auth0 / Okta / flat claim      : roles
# OVC_OIDC_ROLES_CLAIM=resource_access.${client_id}.roles
# This role bypasses every scope filter (full access, no ScopeGrant needed):
# OVC_ADMIN_ROLE=ADMINISTRATOR

# Agent binary storage - where uploaded ovc-agent builds live (Agent Management).
#   local: a directory the API container can write to. Only the API touches it.
#          Absolute paths ("/app/uploads", "/var/lib/ovc/agent-binaries") are used
#          as-is; a relative path ("uploads") is resolved against the app root, not
#          the CWD. Back it with a volume/PVC so builds survive a redeploy.
#   s3:    any S3-compatible object store (credentials via the AWS_* env chain)
OVC_AGENT_STORAGE=local
OVC_AGENT_STORAGE_DIR=/app/uploads/agent-binaries
# OVC_AGENT_S3_BUCKET=ovc-agent-binaries
# OVC_AGENT_S3_PREFIX=agent/
# OVC_AGENT_S3_ENDPOINT_URL=http://minio:9000   # non-empty for MinIO / non-AWS
# OVC_AGENT_S3_REGION=us-east-1
# How long a download URL handed to an agent is valid (S3 presign / local HMAC token)
# OVC_AGENT_DOWNLOAD_URL_TTL_SECONDS=900
# REQUIRED for local-mode agent upgrades: the external URL a Hyper-V host uses to
# reach this API. The agent downloads the binary over plain HTTP from here.
# OVC_PUBLIC_BASE_URL=https://ovc.corp.local

# Task lifecycle
OVC_TASK_TIMEOUT_SECONDS=300
